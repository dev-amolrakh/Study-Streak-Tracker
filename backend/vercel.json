{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
  { "src": "/api/(.*)", "dest": "/api/$1" },
  { "src": "^/$", "dest": "/api" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/$1" },
    { "src": "/.*", "dest": "/frontend/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  }
}
